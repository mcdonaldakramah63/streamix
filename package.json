{
  "name": "streamix",
  "version": "2.0.0",
  "private": true,
  "description": "Streamix — self-hosted streaming front-end (runs locally)",
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "node scripts/dev.js",
    "build": "npm --prefix frontend run build",
    "start": "node backend/server.js",
    "upload": "node scripts/library-upload.js"
  },
  "engines": {
    "node": ">=18"
  }
}
