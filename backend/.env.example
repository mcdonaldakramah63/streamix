# ── Required ──────────────────────────────────────────────────────
PORT=5000
# MongoDB — Atlas connection string, or a local server: mongodb://127.0.0.1:27017/streamix
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/streamix
TMDB_API_KEY=your_tmdb_key_here

# At least 32 random characters — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_minimum_32_char_secret_here
# Optional: separate secret for the 30-day refresh cookie (defaults to JWT_SECRET + suffix)
# JWT_REFRESH_SECRET=

# ── Optional ──────────────────────────────────────────────────────
# Extra browser origins allowed to call the API (comma-separated).
# Defaults cover http://localhost:5173 (Vite) and http://localhost:5000 (built app).
# ALLOWED_ORIGINS=http://192.168.1.20:5000

# Source site used by the `aniwatch` package for direct anime HLS streams.
# The package default (aniwatchtv.to) may be offline; if so, anime falls back to embeds.
# ANIWATCH_DOMAIN=aniwatchtv.to

NODE_ENV=development

# Optional: Claude for "Ask Streamix", personal recommendation reasons and feed headlines, and for double-checking
# library matches the built-in matcher is unsure about. Without it everything runs on the algorithms alone.
ANTHROPIC_API_KEY=
# RECS_AI_MODEL=claude-opus-5-5   # model for recommendations / Ask Streamix
# AI_ASKS_PER_HOUR=30             # Ask Streamix requests per account per hour that may use Claude
# MATCH_AI_MODEL=claude-haiku-4-5-20251001

# Folder for videos stored on this computer (scripts/library-upload.js copies files here). Default: backend/media
# LIBRARY_DIR=/home/you/Videos/streamix
