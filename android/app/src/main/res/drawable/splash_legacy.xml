<?xml version="1.0" encoding="utf-8"?>
<!-- Launch frame for Android 8–11 (Android 12+ uses the system splash in values-v31/themes.xml).
     Same as Claude Design "Streamix Splash Screen", frame 1: the prism mark in a dark circle on Obsidian. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/obsidian" />
    <item android:gravity="center" android:width="160dp" android:height="160dp">
        <shape android:shape="oval"><solid android:color="@color/icon_bg" /></shape>
    </item>
    <item android:gravity="center" android:width="240dp" android:height="240dp" android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
