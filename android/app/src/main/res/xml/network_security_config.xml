<?xml version="1.0" encoding="utf-8"?>
<!-- The Streamix server runs on your own machine over plain HTTP (e.g. http://192.168.1.20:5000),
     so cleartext traffic is allowed. Everything else the app loads (TMDB images, embeds) is HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
